{
  "entries": {
    "text.00cbfb68": "ЭТО НАШ БОЛЬШОЙ ШАНС, МАЙК. У НАС ПОЧТИ ХВАТАЕТ ДЕНЕГ, ЧТОБЫ НАВСЕГДА УЕХАТЬ ИЗ LIBERTY CITY. Я УСТАЛ БЫТЬ МАЛЬЧИКОМ НА ПОБЕГУШКАХ. НАМ НУЖНО СТАТЬ САМОСТОЯТЕЛЬНЫМИ И ЗАЖИТЬ ХОРОШЕЙ ЖИЗНЬЮ.",
    "ui.003e": "НОВАЯ ИГРА",
    "ui.0269": "БУЙСТВО ПРОВАЛЕНО."
